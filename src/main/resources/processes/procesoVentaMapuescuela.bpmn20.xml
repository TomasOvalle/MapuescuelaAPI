<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:design="http://flowable.org/design" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="https://mapuescuela.cl/bpmn" exporter="Flowable Design" exporterVersion="2026.1.1" design:palette="flowable-work-process-palette">
  <process id="procesoVentaMapuescuela" name="Venta de productos - Mapuescuela (TO-BE)" isExecutable="true">
    <documentation>Proceso principal de venta del MVP, alineado con el backend Spring Boot. El proceso comienza cuando el checkout ya creó el pedido. Variables requeridas: pedidoId, modalidadEntrega y pagoAprobado. Los Service Tasks delegan la lógica de negocio a servicios Spring mediante Java Delegates; los datos de negocio permanecen persistidos en PostgreSQL.</documentation>
    <extensionElements>
      <flowable:candidates-type><![CDATA[all]]></flowable:candidates-type>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-08-11T20:58:03.146Z]]></design:creationdate>
      <design:modificationdate><![CDATA[2026-09-19T14:08:00-03:00]]></design:modificationdate>
    </extensionElements>
    <laneSet id="LaneSet_VentaTOBE">
      <lane id="Lane_Cliente" name="Cliente">
        <flowNodeRef>Task_AdjuntarComprobante</flowNodeRef>
      </lane>
      <lane id="Lane_Sistema" name="Sistema / Flowable">
        <flowNodeRef>Event_PedidoGenerado</flowNodeRef>
        <flowNodeRef>BoundaryEvent_Plazo24Horas</flowNodeRef>
        <flowNodeRef>Task_CancelarPorVencimiento</flowNodeRef>
        <flowNodeRef>EndEvent_Vencido</flowNodeRef>
        <flowNodeRef>Gateway_PagoAprobado</flowNodeRef>
        <flowNodeRef>Task_RechazarPago</flowNodeRef>
        <flowNodeRef>EndEvent_PagoRechazado</flowNodeRef>
        <flowNodeRef>Task_DescontarInventario</flowNodeRef>
        <flowNodeRef>Task_IniciarPreparacion</flowNodeRef>
        <flowNodeRef>Gateway_ModalidadEntrega</flowNodeRef>
        <flowNodeRef>Task_MarcarListoRetiro</flowNodeRef>
        <flowNodeRef>Gateway_UnirEntrega</flowNodeRef>
        <flowNodeRef>Task_FinalizarPedido</flowNodeRef>
        <flowNodeRef>EndEvent_Finalizado</flowNodeRef>
      </lane>
      <lane id="Lane_Voluntario" name="Voluntario / administrador">
        <flowNodeRef>Task_RevisarComprobante</flowNodeRef>
        <flowNodeRef>Task_PrepararPedido</flowNodeRef>
        <flowNodeRef>Task_RegistrarRetiro</flowNodeRef>
        <flowNodeRef>Task_RegistrarDespacho</flowNodeRef>
        <flowNodeRef>Task_ConfirmarEntrega</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Event_PedidoGenerado" name="Pedido generado por checkout" flowable:formFieldValidation="false">
      <documentation>El proceso se inicia después de que CarritoService.checkout() creó y persistió el pedido en estado PENDIENTE_PAGO.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
        <flowable:work-form-field-validation><![CDATA[false]]></flowable:work-form-field-validation>
      </extensionElements>
    </startEvent>
    <userTask id="Task_AdjuntarComprobante" name="Adjuntar comprobante de transferencia" flowable:candidateGroups="CLIENTES" flowable:formFieldValidation="false">
      <documentation>El frontend registra el comprobante asociado al pedido y completa esta tarea. El pedido pasa a PAGO_EN_REVISION.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <boundaryEvent id="BoundaryEvent_Plazo24Horas" name="24 horas sin adjuntar el comprobante" attachedToRef="Task_AdjuntarComprobante" cancelActivity="true">
      <extensionElements>
        <design:stencilid><![CDATA[IntermediateTimerEventBoundary]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <timerEventDefinition>
        <timeDuration>${plazoComprobante}</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="Task_CancelarPorVencimiento" name="Cancelar pedido por vencimiento" flowable:delegateExpression="${cancelarPedidoDelegate}">
      <documentation>Marca el pedido PENDIENTE_PAGO como CANCELADO cuando transcurren 24 horas sin comprobante. No descuenta stock.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <endEvent id="EndEvent_Vencido" name="Pedido cancelado por vencimiento">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <userTask id="Task_RevisarComprobante" name="Revisar comprobante de pago" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <documentation>El voluntario revisa el comprobante y completa la tarea informando la variable booleana pagoAprobado.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gateway_PagoAprobado" name="¿Pago aprobado?">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <serviceTask id="Task_RechazarPago" name="Registrar pago rechazado" flowable:delegateExpression="${rechazarPagoDelegate}">
      <documentation>Actualiza el comprobante a RECHAZADO y el pedido a PAGO_RECHAZADO.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <endEvent id="EndEvent_PagoRechazado" name="Pago rechazado">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <serviceTask id="Task_DescontarInventario" name="Aprobar pago y descontar inventario" flowable:delegateExpression="${aprobarPagoYDescontarStockDelegate}">
      <documentation>Aprueba el comprobante, cambia el pedido a PAGO_APROBADO y descuenta el stock de forma transaccional.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="Task_IniciarPreparacion" name="Iniciar preparación del pedido" flowable:delegateExpression="${iniciarPreparacionDelegate}">
      <documentation>Invoca PreparacionPedidoService para cambiar el pedido de PAGO_APROBADO a EN_PREPARACION.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="Task_PrepararPedido" name="Preparar pedido" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <documentation>Tarea humana que representa la preparación física del pedido por parte de un voluntario.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gateway_ModalidadEntrega" name="¿Modalidad de entrega?">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <serviceTask id="Task_MarcarListoRetiro" name="Marcar pedido listo para retiro" flowable:delegateExpression="${marcarListoRetiroDelegate}">
      <documentation>Para modalidad RETIRO, cambia el pedido desde EN_PREPARACION a LISTO_PARA_RETIRO.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="Task_RegistrarRetiro" name="Registrar retiro del pedido" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <documentation>El voluntario confirma que el cliente retiró el pedido. Al completar esta tarea, el proceso puede finalizar el pedido.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="Task_RegistrarDespacho" name="Registrar despacho o envío" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <documentation>El voluntario registra tipo de despacho, empresa, seguimiento y fecha. El frontend utiliza DespachoService / POST /api/despachos, dejando el pedido ENVIADO, y luego completa esta tarea.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="Task_ConfirmarEntrega" name="Confirmar entrega del despacho" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <documentation>Confirma que un pedido previamente ENVIADO fue entregado al cliente antes de finalizarlo.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gateway_UnirEntrega" name="Entrega completada">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <serviceTask id="Task_FinalizarPedido" name="Finalizar pedido" flowable:delegateExpression="${finalizarPedidoDelegate}">
      <documentation>Invoca PreparacionPedidoService.finalizarPedido(pedidoId), pasando LISTO_PARA_RETIRO o ENVIADO a FINALIZADO.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <endEvent id="EndEvent_Finalizado" name="Pedido finalizado">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <sequenceFlow id="Flow_Inicio_Adjuntar" sourceRef="Event_PedidoGenerado" targetRef="Task_AdjuntarComprobante">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Adjuntar_Revisar" sourceRef="Task_AdjuntarComprobante" targetRef="Task_RevisarComprobante">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Plazo_Cancelar" sourceRef="BoundaryEvent_Plazo24Horas" targetRef="Task_CancelarPorVencimiento">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Cancelar_FinVencido" sourceRef="Task_CancelarPorVencimiento" targetRef="EndEvent_Vencido">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Revisar_GatewayPago" sourceRef="Task_RevisarComprobante" targetRef="Gateway_PagoAprobado">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_PagoNo_Rechazar" sourceRef="Gateway_PagoAprobado" targetRef="Task_RechazarPago" name="No">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${pagoAprobado == false}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Rechazar_Fin" sourceRef="Task_RechazarPago" targetRef="EndEvent_PagoRechazado">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_PagoSi_AprobarStock" sourceRef="Gateway_PagoAprobado" targetRef="Task_DescontarInventario" name="Sí">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${pagoAprobado == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_AprobarStock_IniciarPreparacion" sourceRef="Task_DescontarInventario" targetRef="Task_IniciarPreparacion">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_IniciarPreparacion_Preparar" sourceRef="Task_IniciarPreparacion" targetRef="Task_PrepararPedido">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Preparar_GatewayModalidad" sourceRef="Task_PrepararPedido" targetRef="Gateway_ModalidadEntrega">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Retiro_MarcarListo" sourceRef="Gateway_ModalidadEntrega" targetRef="Task_MarcarListoRetiro" name="Retiro">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${modalidadEntrega == 'RETIRO'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_MarcarListo_RegistrarRetiro" sourceRef="Task_MarcarListoRetiro" targetRef="Task_RegistrarRetiro">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_RegistrarRetiro_Unir" sourceRef="Task_RegistrarRetiro" targetRef="Gateway_UnirEntrega">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Despacho_Registrar" sourceRef="Gateway_ModalidadEntrega" targetRef="Task_RegistrarDespacho" name="Despacho">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${modalidadEntrega == 'DESPACHO'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_RegistrarDespacho_ConfirmarEntrega" sourceRef="Task_RegistrarDespacho" targetRef="Task_ConfirmarEntrega">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_ConfirmarEntrega_Unir" sourceRef="Task_ConfirmarEntrega" targetRef="Gateway_UnirEntrega">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Unir_Finalizar" sourceRef="Gateway_UnirEntrega" targetRef="Task_FinalizarPedido">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Finalizar_Fin" sourceRef="Task_FinalizarPedido" targetRef="EndEvent_Finalizado">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
  </process>
