<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:design="http://flowable.org/design" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="https://mapuescuela.cl/bpmn" exporter="Flowable Design" exporterVersion="2026.1.1" design:palette="flowable-work-process-palette">
  <process id="procesoVentaMapuescuela" name="Venta de productos - Mapuescuela (TO-BE)" isExecutable="true">
    <documentation>Proceso principal de venta del MVP. Las variables requeridas son pedidoId, modalidadEntrega,
      pagoAprobado y comprobanteAdjunto. Las tareas de servicio deben actualizar el pedido mediante
      delegados Java o expresiones Flowable configuradas por la aplicación.</documentation>
    <extensionElements>
      <flowable:candidates-type><![CDATA[all]]></flowable:candidates-type>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-08-11T20:58:03.146Z]]></design:creationdate>
      <design:modificationdate><![CDATA[2026-08-12T02:20:26.054Z]]></design:modificationdate>
    </extensionElements>
    <laneSet id="LaneSet_VentaTOBE">
      <lane id="Lane_Cliente" name="Cliente">
        <flowNodeRef>Event_InicioCompra</flowNodeRef>
        <flowNodeRef>Task_SeleccionarProductos</flowNodeRef>
        <flowNodeRef>Task_ConfirmarCompra</flowNodeRef>
        <flowNodeRef>Task_SeleccionarEntrega</flowNodeRef>
        <flowNodeRef>Task_AdjuntarComprobante</flowNodeRef>
        <flowNodeRef>BoundaryEvent_Plazo24Horas</flowNodeRef>
      </lane>
      <lane id="Lane_Sistema" name="Sistema / Flowable">
        <flowNodeRef>Task_CrearPedido</flowNodeRef>
        <flowNodeRef>Task_CancelarPorVencimiento</flowNodeRef>
        <flowNodeRef>Task_RechazarPago</flowNodeRef>
        <flowNodeRef>Task_DescontarInventario</flowNodeRef>
        <flowNodeRef>Task_MarcarListoRetiro</flowNodeRef>
        <flowNodeRef>ServiceTask_4</flowNodeRef>
        <flowNodeRef>Gateway_PagoAprobado</flowNodeRef>
        <flowNodeRef>Gateway_ModalidadEntrega</flowNodeRef>
        <flowNodeRef>EndEvent_Vencido</flowNodeRef>
        <flowNodeRef>EndEvent_PagoRechazado</flowNodeRef>
        <flowNodeRef>EndEvent_RetiroFinalizado</flowNodeRef>
        <flowNodeRef>EndEvent_DespachoFinalizado</flowNodeRef>
      </lane>
      <lane id="Lane_Voluntario" name="Voluntario / administrador">
        <flowNodeRef>Task_RevisarComprobante</flowNodeRef>
        <flowNodeRef>Task_PrepararPedido</flowNodeRef>
        <flowNodeRef>Task_RegistrarRetiro</flowNodeRef>
        <flowNodeRef>Task_RegistrarDespacho</flowNodeRef>
      </lane>
    </laneSet>
    <serviceTask id="Task_CancelarPorVencimiento" name="Se cancela el pedido y los productos seleccionados vuelven a estar disponibles" flowable:class="cl.mapuescuela.process.CancelarPedidoDelegate">
      <documentation>Marca el pedido como CANCELADO. No descuenta stock, por lo que las unidades siguen disponibles.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="Task_AdjuntarComprobante" name="Adjuntar comprobante de transferencia" flowable:candidateGroups="CLIENTES" flowable:formFieldValidation="false">
      <documentation>El cliente carga el archivo. La aplicación guarda el comprobante y completa esta tarea.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="Task_SeleccionarProductos" name="El cliente selecciona uno o más productos" flowable:candidateGroups="CLIENTES" flowable:formFieldValidation="false">
      <documentation>Representa la selección de uno o más productos disponibles. La aplicación valida el stock sin descontarlo todavía.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <serviceTask id="Task_CrearPedido" name="Crear pedido e informar datos de transferencia" flowable:class="cl.mapuescuela.process.CrearPedidoDelegate">
      <documentation>Crea o confirma el pedido, establece PENDIENTE_DE_PAGO y presenta los datos bancarios.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="Task_SeleccionarEntrega" name="El cliente selecciona la  modalidad de entrega" flowable:candidateGroups="CLIENTES" flowable:formFieldValidation="false">
      <documentation>El cliente elige RETIRO o DESPACHO. El valor se guarda en la variable modalidadEntrega.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <serviceTask id="Task_RechazarPago" name="Cancelar el pedido e informar al cliente" flowable:class="cl.mapuescuela.process.RechazarPagoDelegate">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="Task_ConfirmarCompra" name="El cliente confirma la compra e ingresar sus datos " flowable:candidateGroups="CLIENTES" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <serviceTask id="Task_DescontarInventario" name="Se confirma la compra y se actualiza el inventario" flowable:class="cl.mapuescuela.process.AprobarPagoYDescontarStockDelegate">
      <documentation>La actualización debe ser atómica y validar nuevamente el stock disponible.</documentation>
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="Task_RegistrarDespacho" name="Registrar despacho o envío" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <documentation>Registra voluntario o courier, fecha de envío y número de seguimiento si corresponde.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="Task_RevisarComprobante" name="Un voluntario revisa el comprobante de pago" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <documentation>El voluntario aprueba o rechaza e informa la variable booleana pagoAprobado.</documentation>
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <serviceTask id="Task_MarcarListoRetiro" name="Marcar pedido listo para retiro" flowable:class="cl.mapuescuela.process.MarcarListoRetiroDelegate">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="Marcar pedido listo para despacho" flowable:delegateExpression="${marcarPedidoListoDespachoDelegate}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="Task_PrepararPedido" name="Preparar pedido" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <userTask id="Task_RegistrarRetiro" name="Registrar retiro del pedido" flowable:candidateGroups="VOLUNTARIOS" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gateway_PagoAprobado" name="¿Pago aprobado?">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_ModalidadEntrega" name="¿Modalidad de entrega?">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <startEvent id="Event_InicioCompra" name="Cliente inicia compra" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:work-form-field-validation><![CDATA[false]]></flowable:work-form-field-validation>
        <design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </startEvent>
    <endEvent id="EndEvent_Vencido" name="Se registra la cancelación del pedido">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <endEvent id="EndEvent_PagoRechazado" name="Pago rechazado / pedido cancelado">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <endEvent id="EndEvent_RetiroFinalizado" name="Pedido finalizado">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <endEvent id="EndEvent_DespachoFinalizado" name="Pedido finalizado">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <sequenceFlow id="Flow_Cancelar_FinVencido" sourceRef="Task_CancelarPorVencimiento" targetRef="EndEvent_Vencido">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <boundaryEvent id="BoundaryEvent_Plazo24Horas" name="24 horas sin adjuntar el comprobante" attachedToRef="Task_AdjuntarComprobante" cancelActivity="true">
      <extensionElements>
        <design:stencilid><![CDATA[IntermediateTimerEventBoundary]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <timerEventDefinition>
        <timeDuration>PT24H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="Flow_Plazo_Cancelar" sourceRef="BoundaryEvent_Plazo24Horas" targetRef="Task_CancelarPorVencimiento">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_AdjuntarComprobante_RevisarComprobante" sourceRef="Task_AdjuntarComprobante" targetRef="Task_RevisarComprobante">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_SeleccionarProductos_ConfirmarCompra" sourceRef="Task_SeleccionarProductos" targetRef="Task_ConfirmarCompra">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_CrearPedido_AdjuntarComprobante" sourceRef="Task_CrearPedido" targetRef="Task_AdjuntarComprobante">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_SeleccionarEntrega_CrearPedido" sourceRef="Task_SeleccionarEntrega" targetRef="Task_CrearPedido">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_RechazarPago_Fin" sourceRef="Task_RechazarPago" targetRef="EndEvent_PagoRechazado">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_ConfirmarCompra_SeleccionarEntrega" sourceRef="Task_ConfirmarCompra" targetRef="Task_SeleccionarEntrega">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_DescontarInventario_Preparar" sourceRef="Task_DescontarInventario" targetRef="Task_PrepararPedido">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_RegistrarDespacho_Fin" sourceRef="Task_RegistrarDespacho" targetRef="EndEvent_DespachoFinalizado">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_RevisarComprobante_GatewayPago" sourceRef="Task_RevisarComprobante" targetRef="Gateway_PagoAprobado">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_MarcarListo_RegistrarRetiro" sourceRef="Task_MarcarListoRetiro" targetRef="Task_RegistrarRetiro">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_4" targetRef="Task_RegistrarDespacho">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_Preparar_GatewayModalidad" sourceRef="Task_PrepararPedido" targetRef="Gateway_ModalidadEntrega">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_RegistrarRetiro_Fin" sourceRef="Task_RegistrarRetiro" targetRef="EndEvent_RetiroFinalizado">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_PagoNo_RechazarPago" name="No" sourceRef="Gateway_PagoAprobado" targetRef="Task_RechazarPago">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${pagoAprobado == false}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_PagoSi_DescontarInventario" name="Sí" sourceRef="Gateway_PagoAprobado" targetRef="Task_DescontarInventario">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${pagoAprobado == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Retiro_MarcarListo" name="Retiro" sourceRef="Gateway_ModalidadEntrega" targetRef="Task_MarcarListoRetiro">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${modalidadEntrega == 'RETIRO'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Despacho_Registrar" name="Despacho" sourceRef="Gateway_ModalidadEntrega" targetRef="ServiceTask_4">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${modalidadEntrega == 'DESPACHO'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Inicio_SeleccionarProductos" sourceRef="Event_InicioCompra" targetRef="Task_SeleccionarProductos">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
  </process>
